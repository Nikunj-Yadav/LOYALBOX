# Copy to .env and fill in real values. NEVER commit .env.
APP_ENV=production
APP_TIMEZONE=UTC
# Public base URL used inside printed claim links (no trailing slash). Example: https://rewards.example.com/customer
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loyalbox
DB_USER=change_me
DB_PASS=change_me

# Secret used to HMAC product codes (min 32 chars). Generate with: php -r "echo bin2hex(random_bytes(32)),PHP_EOL;"
# Changing it later makes every existing code unverifiable, so back it up.
CODE_PEPPER=change_me_to_64_hex_chars
