# OPTIONAL. On XAMPP you do not need this file (defaults: root, empty password, database "loyalbox").
# Copy to .env only to override settings. NEVER commit .env.
APP_ENV=production
APP_TIMEZONE=UTC
# Public base URL used inside printed claim links (no trailing slash). Example: https://rewards.example.com/customer
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loyalbox
DB_USER=root
DB_PASS=

# Optional. If you leave CODE_PEPPER out, a secret is created automatically in config/secret.key.
# Changing it later makes every existing code unverifiable, so back it up.
# CODE_PEPPER=
